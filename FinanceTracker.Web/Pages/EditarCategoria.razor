@page "/categorias/{CategoriaId:int}/editar"

<h3>EditarCategoria</h3>

@inject ICategoriaApiService CategoriaService
@inject NavigationManager Navigation

<PageTitle>Editar categoría</PageTitle>

<h1>Editar categoría</h1>

@if (cargando)
{
    <p>Cargando categoría...</p>
}
else if (!string.IsNullOrWhiteSpace(errorCarga))
{
    <div class="alert alert-danger">
        @errorCarga
    </div>
}
else
{
    <div class="card">
        <div class="card-body">

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="alert alert-danger">
                    @error
                </div>
            }

            <div class="mb-3">
                <label class="form-label">
                    Tipo
                </label>

                <input class="form-control"
                       value="@ObtenerNombreTipo()"
                       disabled />

                <div class="form-text">
                    El tipo de una categoría no puede
                    modificarse después de su creación.
                </div>
            </div>

            <EditForm Model="modelo"
                      OnValidSubmit="GuardarAsync">

                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">
                        Nombre
                    </label>

                    <InputText class="form-control"
                               @bind-Value="modelo.NombreCategoria" />

                    <ValidationMessage
                        For="@(() => modelo.NombreCategoria)" />
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@guardando">
                        @(guardando
                            ? "Guardando..."
                            : "Guardar cambios")
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="Cancelar">
                        Cancelar
                    </button>

                </div>

            </EditForm>

        </div>
    </div>
}

@code {
    [Parameter]
    public int CategoriaId { get; set; }

    private ActualizarCategoriaRequest modelo =
        new();

    private TipoTransaccion tipo;

    private bool cargando = true;

    private bool guardando;

    private string? error;

    private string? errorCarga;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            cargando = true;

            var categoria =
                await CategoriaService
                    .ObtenerPorIdAsync(CategoriaId);

            if (categoria is null)
            {
                errorCarga =
                    "La categoría no existe.";

                return;
            }

            tipo = categoria.Tipo;

            modelo =
                new ActualizarCategoriaRequest
                {
                    NombreCategoria =
                        categoria.NombreCategoria
                };
        }
        catch (ApiException ex)
        {
            errorCarga = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorCarga =
                "No fue posible comunicarse con la API.";
        }
        catch (Exception)
        {
            errorCarga =
                "No fue posible cargar la categoría.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarAsync()
    {
        try
        {
            guardando = true;
            error = null;

            await CategoriaService
                .ActualizarAsync(
                    CategoriaId,
                    modelo);

            Navigation.NavigateTo("/categorias");
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error =
                "No fue posible comunicarse con la API.";
        }
        catch (Exception)
        {
            error =
                "Ocurrió un error inesperado.";
        }
        finally
        {
            guardando = false;
        }
    }

    private string ObtenerNombreTipo()
    {
        return tipo switch
        {
            TipoTransaccion.Ingreso => "Ingreso",
            TipoTransaccion.Gasto => "Gasto",
            _ => "Desconocido"
        };
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/categorias");
    }
}
