@page "/transacciones/nueva"

@inject IUsuarioApiService UsuarioService
@inject ICuentaApiService CuentaService
@inject ICategoriaApiService CategoriaService
@inject ITransaccionApiService TransaccionService
@inject NavigationManager Navigation

<PageTitle>Nueva transacción</PageTitle>

<h1>Nueva transacción</h1>

@if (cargando)
{
    <p>Cargando...</p>
}
else if (!string.IsNullOrWhiteSpace(errorCarga))
{
    <div class="alert alert-danger">
        @errorCarga
    </div>
}
else
{
    <div class="card mb-4">
        <div class="card-body">

            <div>
                <strong>Usuario:</strong>
                @nombreUsuario
            </div>

            <div>
                <strong>Cuenta:</strong>
                @nombreCuenta
            </div>

        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">
            @error
        </div>
    }

    <div class="card">
        <div class="card-body">

            <EditForm Model="modelo"
                OnValidSubmit="GuardarAsync">

                <DataAnnotationsValidator />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">
                            Tipo
                        </label>

                        <InputSelect TValue="TipoTransaccion"
                            class="form-select"
                            @bind-Value="modelo.Tipo"
                            @bind-Value:after="TipoCambiado">

                            <option value="@TipoTransaccion.Ingreso">
                                Ingreso
                            </option>

                            <option value="@TipoTransaccion.Gasto">
                                Gasto
                            </option>

                        </InputSelect>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Categoría
                        </label>

                        <InputSelect class="form-select"
                                     @bind-Value="modelo.CategoriaId">

                            <option value="0">
                                Seleccione una categoría
                            </option>

                            @foreach (var categoria
                                in CategoriasFiltradas)
                            {
                                <option value="@categoria.CategoriaId">
                                    @categoria.NombreCategoria
                                </option>
                            }

                        </InputSelect>

                        <ValidationMessage
                            For="@(() => modelo.CategoriaId)" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Cantidad
                        </label>

                        <InputNumber class="form-control"
                                     step="0.01"
                                     @bind-Value="modelo.Cantidad" />

                        <ValidationMessage
                            For="@(() => modelo.Cantidad)" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Fecha
                        </label>

                        <InputDate class="form-control"
                                   @bind-Value="modelo.FechaTransaccion" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">
                            Descripción
                        </label>

                        <InputTextArea class="form-control"
                                       rows="3"
                                       @bind-Value="modelo.Descripcion" />

                        <ValidationMessage
                            For="@(() => modelo.Descripcion)" />
                    </div>

                </div>

                <div class="d-flex gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@guardando">
                        @(guardando
                            ? "Guardando..."
                            : "Guardar transacción")
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            disabled="@guardando"
                            @onclick="Cancelar">
                        Cancelar
                    </button>

                </div>

            </EditForm>

        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "usuarioId")]
    public int UsuarioId { get; set; }

    [SupplyParameterFromQuery(Name = "cuentaId")]
    public int CuentaId { get; set; }

    private CrearTransaccionRequest modelo = new();

    private List<CategoriaDto> categorias = [];

    private string nombreUsuario = string.Empty;

    private string nombreCuenta = string.Empty;

    private bool cargando = true;

    private bool guardando;

    private string? error;

    private string? errorCarga;

    private IEnumerable<CategoriaDto> CategoriasFiltradas => categorias.Where(c => c.Tipo == modelo.Tipo);

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            cargando = true;
            errorCarga = null;

            if (UsuarioId <= 0 ||CuentaId <= 0)
            {
                errorCarga = "No se especificó un usuario o cuenta válida.";
                return;
            }

            var usuarioTask = UsuarioService.ObtenerUsuarioPorIdAsync(UsuarioId);

            var cuentaTask = CuentaService.ObtenerPorIdAsync(CuentaId);

            var categoriasTask = CategoriaService.ObtenerPorUsuarioAsync(UsuarioId);

            await Task.WhenAll(usuarioTask, cuentaTask, categoriasTask);

            var usuario = await usuarioTask;

            var cuenta = await cuentaTask;

            if (usuario is null)
            {
                errorCarga = "El usuario no existe o está inactivo.";
                return;
            }

            if (cuenta is null)
            {
                errorCarga = "La cuenta no existe o está inactiva.";
                return;
            }

            if (cuenta.UsuarioId != usuario.UsuarioId)
            {
                errorCarga = "La cuenta no pertenece al usuario indicado.";
                return;
            }

            nombreUsuario = usuario.NombreUsuario;

            nombreCuenta = cuenta.NombreCuenta;

            categorias = (await categoriasTask).ToList();

            modelo.CuentaId = cuenta.CuentaId;

            modelo.Tipo = TipoTransaccion.Gasto;

            modelo.FechaTransaccion = DateOnly.FromDateTime(DateTime.Today);
        }
        catch (ApiException ex)
        {
            errorCarga = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorCarga = "No fue posible comunicarse con la API.";
        }
        catch (Exception)
        {
            errorCarga = "No fue posible cargar la información necesaria.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void TipoCambiado()
    {
        modelo.CategoriaId = 0;
    }

    private async Task GuardarAsync()
    {
        try
        {
            guardando = true;
            error = null;

            var categoria = categorias
                .FirstOrDefault(c => c.CategoriaId == modelo.CategoriaId);

            if (categoria is null)
            {
                error = "Debe seleccionar una categoría válida.";
                return;
            }

            if (categoria.Tipo != modelo.Tipo)
            {
                error = "La categoría seleccionada no corresponde al tipo de transacción.";
                return;
            }

            await TransaccionService.CrearAsync(modelo);

            Navigation.NavigateTo("/transacciones" + $"?usuarioId={UsuarioId}" + $"&cuentaId={CuentaId}");
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error =
                "No fue posible comunicarse con la API.";
        }
        catch (Exception)
        {
            error =
                "Ocurrió un error inesperado.";
        }
        finally
        {
            guardando = false;
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/transacciones" + $"?usuarioId={UsuarioId}" + $"&cuentaId={CuentaId}");
    }
}
